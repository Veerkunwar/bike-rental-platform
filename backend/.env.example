# ---------- SERVER ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- DATABASE ----------
MONGODB_URI=mongodb+srv://veerkunwarsingh19296_db_user:CEG22rp48zoSWoec@cluster0.q9kskwd.mongodb.net/RideIt?retryWrites=true&w=majority
# ---------- JWT ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_to_a_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ---------- ADMIN SEED ----------
ADMIN_EMAIL=admin@bikerental.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- RAZORPAY (test/sandbox keys go here) ----------
# Sign up at https://dashboard.razorpay.com/ , switch to "Test Mode",
# and copy the Test Key ID / Secret from Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# If no real keys are supplied, the razorpayService automatically
# falls back to a MOCK mode so the booking flow still works end to end.
PAYMENTS_MOCK_MODE=true

# ---------- MAPS ----------
# Google Maps or Mapbox key used by the FRONTEND (Vite env, see frontend/.env.example)
MAP_PROVIDER=mapbox

# ---------- FILE STORAGE ----------
# STORAGE_DRIVER=local | s3 | cloudinary
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EMAIL ----------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bike Rental <no-reply@bikerental.com>"

# ---------- OTP ----------
OTP_EXPIRY_MINUTES=10
# OTP_MOCK_MODE prints the OTP to the server console/response instead of
# actually sending SMS, useful until an SMS provider (e.g. Twilio/MSG91) is wired in.
OTP_MOCK_MODE=true

# ---------- TWILIO (real SMS OTP — only used when OTP_MOCK_MODE=false) ----------
# Sign up at https://www.twilio.com/, buy/verify a phone number, and copy
# the Account SID + Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- RATE LIMITING ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
